      "scan_page": 264,
      "locator": "Commune overview, route",
      "verbatim_quote": "西南麻塘河流入境内，西北有板桥河流入中部，于岔河口汇入太极河，最低海拔880米。太极河向东北流出，入红岩公社，由于众山拱护，河流迂回其间，形似太极图，因此得名。",
      "checked": true,
      "source_date": null,
      "observation": {
        "name": "太极河",
        "pinyin": null,
        "population": null,
        "households": null,
