        ],
        "parent_id": null,
        "rank": null,
        "seat_id": null,
        "coordinate": null,
        "former_names": [],
        "note": "Five brigades, 83 production teams and 49 natural villages; 137 Miao, one Mongol and one resident of another unnamed ethnic group, with the remainder Han."
