    {
      "id": "bdd202f3-1fe2-52d4-a452-8835c50cb1a8",
      "key": "bijie-gazetteer/p305/gaoshanpu-commune/chronology",
      "entity_id": "d9b33945-1e05-5e69-b53c-97978da19519",
      "source_id": "bijie-gazetteer",
      "page_or_sheet": "305",
      "scan_page": 340,
      "locator": "Commune overview: chronology",
      "verbatim_quote": "民国时属清水乡所辖，1949年解放。50年建立高山村人民政府。土地改革后54年建立乡政府办初级社，56年进入高级社。58年成立高山人民公社，66年“四清”后，将南关、小沟两社并入，公社机关仍驻高山铺，81年经地名普查改复原名，为高山铺人民公社。",
      "checked": true,
      "source_date": null,
