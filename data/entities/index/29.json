      {
        "id": "aab33db9-ed93-5747-9ba0-052bf4459da9",
        "key": "bijie-gazetteer/p319/shengji-commune/chronology",
        "entity_id": "29c3e2d3-39cf-5a67-b589-899c5d4c7660",
        "source_id": "bijie-gazetteer",
        "page_or_sheet": "319",
        "scan_page": 354,
        "locator": "Commune overview: chronology",
        "verbatim_quote": "明清属夷目地，明国属清水乡保甲地，解放后，50年建村人民政府，土改后54年建乡，农业合作化办初级社，56年进入高级社，58年成立公社，因公社机关驻地生机，命名为生机人民公社。",
        "checked": true,
